programa "Enquanto"

inicio

escreva "===== TESTE 1 ====="

numero contador recebe 1

enquanto contador menor ou igual a 5
    escreva contador
    contador recebe contador mais 1
fim


escreva "===== TESTE 2 ====="

contador recebe 10
enquanto contador menor que 10
    escreva "ERRO"
fim


escreva "===== TESTE 3 ====="

contador recebe 1

enquanto verdadeiro
e contador menor ou igual a 3
    escreva contador
    contador recebe contador mais 1
fim


escreva "===== TESTE 4 ====="

contador recebe 1

enquanto nao contador maior que 3
    escreva contador
    contador recebe contador mais 1
fim


escreva "===== TESTE 5 ====="

contador recebe 5

enquanto contador maior que 0
    escreva contador
    contador recebe contador menos 1

fim


escreva "===== TESTE 6 ====="

contador recebe 1

enquanto contador menor ou igual a 5
    se resto de contador dividido por 2 igual a 0
        escreva "Par"
    senao
        escreva "Impar"
    fim
    contador recebe contador mais 1
fim


escreva "===== TESTE 7 ====="

numero i recebe 1

enquanto i menor ou igual a 3
    numero j recebe 1
    enquanto j menor ou igual a 2
        escreva i
        escreva j
        j recebe j mais 1
    fim
    i recebe i mais 1
fim


fim